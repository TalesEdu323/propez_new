# ==============================================================================
# PropEZ — Variáveis de ambiente
# ==============================================================================
# Copie este arquivo para `.env` (nunca commitar) e ajuste os valores marcados
# com <PREENCHER>. Nunca coloque chaves, senhas ou connection strings reais aqui.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1) Infraestrutura básica
# ------------------------------------------------------------------------------

# URL pública do app (usada para success/cancel do Stripe, CORS e como base dos
# webhooks que enviamos para ProSync/Rubrica).
#
# Em prod (Vercel): https://propez.taggo.com.br
# Em dev local:    http://localhost:3001  (webhooks externos não chegam aqui;
#                  para receber webhooks reais, use ngrok/Cloudflare Tunnel ou
#                  consuma direto da produção).
APP_URL=https://propez.taggo.com.br

# Porta do servidor Express (default 3000). Irrelevante em Vercel.
PORT=3001

# Origens extras permitidas no CORS (separadas por vírgula, sem espaços).
# O próprio APP_URL e localhost já são liberados automaticamente; inclua aqui
# apenas domínios adicionais (ex.: staging, domínio de marca, etc.).
CORS_ORIGINS=https://propez.taggo.com.br,http://localhost:3001

# NODE_ENV controla o modo de bundle (Vite dev vs. dist estático).
# Em prod, defina como `production` na plataforma (Cloud Run, etc.).
# NODE_ENV=production


# ------------------------------------------------------------------------------
# 2) Banco de dados (Neon / Postgres)
# ------------------------------------------------------------------------------
# String de conexão Postgres com SSL. O PropEZ usa como fonte única de dados:
# organizações, usuários, clientes, serviços, contratos, modelos, propostas,
# usage counters E as tabelas de integrações (ProSync/Rubrica).
#
# No boot o servidor aplica automaticamente todos os scripts em `sql/*.sql`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"


# ------------------------------------------------------------------------------
# 3) Autenticação (JWT + cookies httpOnly)
# ------------------------------------------------------------------------------
# Segredo usado para assinar o access token (JWT). Em produção é obrigatório.
# Gere com `openssl rand -hex 64`.
JWT_SECRET=<PREENCHER_openssl_rand_hex_64>

# Nome do cookie de acesso (default propez_session). Use outro nome se tiver
# mais de um app PropEZ no mesmo domínio.
SESSION_COOKIE_NAME=propez_session

# Tempo de vida dos tokens (segundos). Defaults: 15 min access, 30 dias refresh.
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000


# ------------------------------------------------------------------------------
# 4) Email transacional — Hostinger SMTP (nodemailer)
# ------------------------------------------------------------------------------
MAIL_FROM=PropEZ <noreplypropez@taggo.com.br>
MAIL_PROVIDER=smtp
EMAIL_PROVIDER=nodemailer

EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=noreplypropez@taggo.com.br
EMAIL_PASS=<PREENCHER>
EMAIL_TIMEOUT=30000
EMAIL_GREETING_TIMEOUT=8000

# Aliases SMTP (mesmos valores; o código aceita EMAIL_* ou SMTP_*)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreplypropez@taggo.com.br
SMTP_PASS=<PREENCHER>

# Resend desativado — usar só SMTP
RESEND_API_KEY=


# ------------------------------------------------------------------------------
# 5) Stripe — pagamento e assinaturas
# ------------------------------------------------------------------------------

# Chave secreta do Stripe (painel > Developers > API keys).
#   - `sk_test_...` para sandbox
#   - `sk_live_...` para produção
STRIPE_SECRET_KEY=sk_live_<PREENCHER>

# Chave restrita (rk_) read-only para métricas admin (opcional; fallback: STRIPE_SECRET_KEY)
# STRIPE_RESTRICTED_KEY=rk_live_...

# Link externo do painel de suporte (Intercom, Zendesk, etc.)
# SUPPORT_DASHBOARD_URL=https://...

# Secret do webhook (painel > Developers > Webhooks > endpoint).
# Endpoint a configurar no painel: {APP_URL}/api/stripe/webhook
# Eventos mínimos a escutar:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#   invoice.payment_succeeded
#   invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_<PREENCHER>

# Price IDs dos planos (já criados em live mode via MCP).
# Se criar novos em outra conta/ambiente, substitua pelos IDs correspondentes.
#
# Plano Pro     — R$ 89/mês   ou  R$ 828/ano   (2 meses grátis → R$ 69/mês)
STRIPE_PRICE_PRO_MONTHLY=price_1TOKJpJpoS0DWavr1GJcEKVh
STRIPE_PRICE_PRO_YEARLY=price_1TOKJpJpoS0DWavrd4xBru73
#
# Plano Business — R$ 249/mês  ou  R$ 2.388/ano (2 meses grátis → R$ 199/mês)
STRIPE_PRICE_BUSINESS_MONTHLY=price_1TOKJqJpoS0DWavrRKbFZMjQ
STRIPE_PRICE_BUSINESS_YEARLY=price_1TOKJrJpoS0DWavrX2FfABC3


# ------------------------------------------------------------------------------
# 6) ProSync (CRM) — integração opcional
# ------------------------------------------------------------------------------
# Usado pelo plano Pro/Business para sincronizar clientes e propostas.
# Deixe em branco se não for usar ProSync — o app continua funcionando.
#
# Produção (Vercel): https://prosync.tech
# Local:            http://localhost:<porta-prosync>  (se rodar pnpm dev no projeto Prosync)
PROSYNC_API_URL=https://prosync.tech
PROSYNC_API_KEY=ps_live_<PREENCHER>

# Secret usado para validar HMAC de webhooks recebidos do ProSync.
# Gere um valor aleatório forte (ex.: `openssl rand -hex 32`) e cadastre o mesmo
# no painel ProSync ao configurar o webhook de volta.
PROSYNC_WEBHOOK_SECRET=<PREENCHER_openssl_rand_hex_32>


# ------------------------------------------------------------------------------
# 7) Rubrica (assinatura eletrônica) — integração opcional
# ------------------------------------------------------------------------------
# Usado pelo plano Pro/Business para enviar contratos para assinatura digital.
# Deixe em branco se não for usar Rubrica.
#
# Produção (Vercel): https://app.rubrica.com.br
RUBRICA_API_URL=https://app.rubrica.com.br
RUBRICA_API_KEY=dm_live_<PREENCHER>

# Secret passado em query string ao Rubrica para autenticar os webhooks de volta.
# Gere um valor aleatório forte (`openssl rand -hex 32`).
RUBRICA_WEBHOOK_SECRET=<PREENCHER_openssl_rand_hex_32>


# ==============================================================================
# Checklist de deploy
# ==============================================================================
# [ ] APP_URL apontando para o domínio real (sem barra no final)
# [ ] DATABASE_URL com sslmode=require (PropEZ aplica sql/*.sql no boot)
# [ ] JWT_SECRET com pelo menos 64 bytes hex (openssl rand -hex 64)
# [ ] RESEND_API_KEY + MAIL_FROM configurados (verificação de email obriga)
# [ ] STRIPE_SECRET_KEY em modo live
# [ ] Webhook cadastrado no Stripe apontando para {APP_URL}/api/stripe/webhook
#     e STRIPE_WEBHOOK_SECRET copiado do painel
# [ ] Todos os 4 STRIPE_PRICE_* preenchidos
# [ ] NODE_ENV=production definido na plataforma (Cloud Run, Vercel, etc.)
# [ ] CORS_ORIGINS incluindo qualquer domínio alternativo (ex.: www. + apex)
# [ ] ProSync: script CREATE_API_KEYS_AND_WEBHOOKS.sql aplicado no DB do ProSync
# [ ] ProSync: PROSYNC_API_KEY + PROSYNC_WEBHOOK_SECRET (igual ao secret do webhook outbound)
# [ ] Rubrica: RUBRICA_API_KEY (webhook de volta usa secret por URL; ver docs/INTEGRACOES_SMOKE_TEST.md)
# [ ] Boot PropEZ: log "[startup] integration schema OK" e npm run check:integrations com dev rodando
# ==============================================================================
