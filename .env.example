NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/propez

# Auth
JWT_SECRET=change-me
SESSION_COOKIE_NAME=propez_session
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000

# CORS (opcional, separado por virgula)
CORS_ORIGINS=

# Mail
RESEND_API_KEY=
MAIL_FROM=Propez <no-reply@propez.local>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Integracoes
PROSYNC_API_URL=https://app.prosync.com.br
PROSYNC_API_KEY=
PROSYNC_WEBHOOK_SECRET=
RUBRICA_API_URL=https://app.rubrica.com.br
RUBRICA_API_KEY=
RUBRICA_WEBHOOK_SECRET=

# Diagnosticos e checks (opcional)
DISABLE_HMR=false
PROP_EZ_CHECK_URL=http://127.0.0.1:3000
INTEGRATION_CHECK=false

# Seed local (opcional)
SEED_EMAIL=dev@propez.local
SEED_PASSWORD=dev123dev
SEED_COMPANY=Propez Dev
SEED_NAME=Propez Dev
