# ═══════════════════════════════════════════════════════════════════════════════
# PropEZ — Environment Configuration (template)
# ═══════════════════════════════════════════════════════════════════════════════
# Copie para `.env` e preencha valores marcados com <PREENCHER>.
# Nunca coloque segredos reais neste arquivo.
#
# Documentação: docs/suite-taggo/GUIA-COMPLETO.md
# Produção:     docs/suite-taggo/templates/propez.env.production.example
# ═══════════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────────
# A) Runtime & rede
# ───────────────────────────────────────────────────────────────────────────────

# NODE_ENV=development
# NODE_ENV=production

APP_URL=https://propez.taggo.com.br
PORT=3001
CORS_ORIGINS=https://propez.taggo.com.br,http://localhost:3001

# DISABLE_HMR=true


# ───────────────────────────────────────────────────────────────────────────────
# B) Banco de dados (Neon / Postgres)
# ───────────────────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"


# ───────────────────────────────────────────────────────────────────────────────
# C) Autenticação & sessão
# ───────────────────────────────────────────────────────────────────────────────

JWT_SECRET=<PREENCHER_openssl_rand_hex_64>
SESSION_COOKIE_NAME=propez_session
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000

# PLATFORM_ADMIN_EMAILS=admin@empresa.com


# ───────────────────────────────────────────────────────────────────────────────
# D) Suíte Taggo — HMAC cross-app & cifra de credenciais
# ───────────────────────────────────────────────────────────────────────────────

# Idêntico em Propez, ProSync, Rubrica e Site — openssl rand -hex 64
TAGGO_SUITE_SECRET=<PREENCHER_openssl_rand_hex_64>

# CREDENTIALS_KEY=<PREENCHER_opcional_chave_aes_dedicada>


# ───────────────────────────────────────────────────────────────────────────────
# E) Email transacional (SMTP)
# ───────────────────────────────────────────────────────────────────────────────

MAIL_PROVIDER=smtp
MAIL_FROM=PropEZ <noreply@example.com>

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=<PREENCHER>
SMTP_TIMEOUT=30000
SMTP_GREETING_TIMEOUT=8000

# Alternativa: Resend (deixar SMTP vazio se usar)
RESEND_API_KEY=


# ───────────────────────────────────────────────────────────────────────────────
# F) Stripe — billing & assinaturas
# ───────────────────────────────────────────────────────────────────────────────

# sk_test_... (sandbox) | sk_live_... (produção)
STRIPE_SECRET_KEY=sk_live_<PREENCHER>

# Webhook: {APP_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_<PREENCHER>

# STRIPE_RESTRICTED_KEY=rk_live_<PREENCHER_opcional>

STRIPE_PRICE_PRO_MONTHLY=price_1TOKJpJpoS0DWavr1GJcEKVh
STRIPE_PRICE_PRO_YEARLY=price_1TOKJpJpoS0DWavrd4xBru73
STRIPE_PRICE_BUSINESS_MONTHLY=price_1TOKJqJpoS0DWavrRKbFZMjQ
STRIPE_PRICE_BUSINESS_YEARLY=price_1TOKJrJpoS0DWavrX2FfABC3


# ───────────────────────────────────────────────────────────────────────────────
# G) Integrações — ProSync (CRM)
# ───────────────────────────────────────────────────────────────────────────────

PROSYNC_API_URL=https://prosync.tech
PROSYNC_API_KEY=ps_live_<PREENCHER>
PROSYNC_WEBHOOK_SECRET=<PREENCHER_openssl_rand_hex_32>


# ───────────────────────────────────────────────────────────────────────────────
# H) Integrações — Rubrica (assinatura eletrônica)
# ───────────────────────────────────────────────────────────────────────────────

RUBRICA_API_URL=https://app.rubrica.com.br
RUBRICA_API_KEY=dm_live_<PREENCHER>
RUBRICA_WEBHOOK_SECRET=<PREENCHER_openssl_rand_hex_32>


# ───────────────────────────────────────────────────────────────────────────────
# I) SSO Taggo (opcional)
# ───────────────────────────────────────────────────────────────────────────────

# TAGGO_SSO_ISSUER=https://accounts.taggo.com.br
# TAGGO_SSO_CLIENT_ID=propez
# TAGGO_SSO_CLIENT_SECRET=<PREENCHER>
# TAGGO_SSO_REDIRECT_URI=https://propez.taggo.com.br/api/sso/callback


# ───────────────────────────────────────────────────────────────────────────────
# J) Operações & admin (opcional)
# ───────────────────────────────────────────────────────────────────────────────

# SUPPORT_DASHBOARD_URL=https://suporte.example.com


# ───────────────────────────────────────────────────────────────────────────────
# K) Desenvolvimento local (não usar em produção)
# ───────────────────────────────────────────────────────────────────────────────

# PROP_EZ_CHECK_URL=http://127.0.0.1:3001
# INTEGRATION_CHECK=true
# SEED_EMAIL=dev@propez.local
# SEED_PASSWORD=dev123dev
# SEED_COMPANY=Propez Dev
# SEED_NAME=Propez Dev
# GEMINI_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# Checklist de deploy
# ═══════════════════════════════════════════════════════════════════════════════
# [ ] NODE_ENV=production no hosting
# [ ] APP_URL = domínio real (sem barra final)
# [ ] DATABASE_URL com sslmode=require
# [ ] JWT_SECRET ≥ 64 hex (openssl rand -hex 64)
# [ ] TAGGO_SUITE_SECRET idêntico nos 4 apps da suíte
# [ ] SMTP_* ou RESEND_API_KEY + MAIL_FROM configurados
# [ ] STRIPE_SECRET_KEY + webhook + 4 STRIPE_PRICE_*
# [ ] PROSYNC_* e RUBRICA_* (keys + webhook secrets pareados)
# [ ] CORS_ORIGINS com domínios alternativos (www, staging)
# [ ] Boot: "[startup] integration schema OK" + npm run check:integrations
# ═══════════════════════════════════════════════════════════════════════════════
