# ═══════════════════════════════════════════════════════════════════════════════
# PropEZ — template de variáveis de ambiente
# ═══════════════════════════════════════════════════════════════════════════════
# Uso:  cp .env.example .env
#       (edite .env com valores reais — .env não vai para o Git)
#
# Mais exemplos: docs/suite-taggo/templates/
# Deploy:        docs/DEPLOY.md
# ═══════════════════════════════════════════════════════════════════════════════

# ── Runtime ──
# NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
CORS_ORIGINS=http://localhost:3000

# ── Banco (Neon / Postgres) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# ── Vercel Blob (PDF de contratos em produção) ──
# Production/Preview: ligado ao Blob Store no painel Vercel (auto-injetado).
# BLOB_STORE_ID e BLOB_WEBHOOK_PUBLIC_KEY também são injetados — só BLOB_READ_WRITE_TOKEN é usado no código.
# Local: npx vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=

# ── Auth ──
JWT_SECRET=<PREENCHER_openssl_rand_hex_64>
SESSION_COOKIE_NAME=propez_session
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000

# ── Google OAuth (login + Google Agenda) ──
# Google Cloud Console → OAuth 2.0 Client (Web). Habilitar Google Calendar API.
# Redirect URIs (mesmo client):
#   {APP_URL}/api/auth/google/callback
#   {APP_URL}/api/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Suíte Taggo (plataforma — não substitui credencial por cliente) ──
# HMAC partner (service-token, proposal-events). Cada org conecta o ProSync dela em Configurações → Integrações.
TAGGO_SUITE_SECRET=<PREENCHER_openssl_rand_hex_64>
# Site institucional Taggo (rodapé de e-mails transacionais)
TAGGO_SITE_URL=https://taggo.com.br

# ── Marketing (Vite — expostas no build do frontend) ──
VITE_PROSYNC_URL=https://prosync.tech
# VITE_WHATSAPP_URL=5511999999999
# CREDENTIALS_KEY=<PREENCHER_opcional>

# ── Email (SMTP ou Resend) ──
# Local: SMTP (ex. Hostinger). Vercel (produção): use Resend (HTTP, confiável em serverless).
MAIL_PROVIDER=smtp
MAIL_FROM=PropEZ <noreply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=<PREENCHER>
# Vercel Production + Preview (obrigatório se não usar SMTP na Vercel):
# MAIL_PROVIDER=resend
RESEND_API_KEY=

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_<PREENCHER>
STRIPE_WEBHOOK_SECRET=whsec_<PREENCHER>
STRIPE_PRICE_PRO_MONTHLY=price_<PREENCHER>
STRIPE_PRICE_PRO_YEARLY=price_<PREENCHER>
STRIPE_PRICE_BUSINESS_MONTHLY=price_<PREENCHER>
STRIPE_PRICE_BUSINESS_YEARLY=price_<PREENCHER>

# ── Integrações ──
# URLs padrão só quando a org não define api_base_url; chaves CRM são POR ORG no banco.
# Assinatura de contratos é nativa no PropEZ (tecnologia Rubrica · Powered by Taggo).
PROSYNC_API_URL=https://prosync.tech
PROSYNC_WEBHOOK_SECRET=<PREENCHER_openssl_rand_hex_32>

# Opcional legado single-tenant (Vercel pode omitir):
# PROSYNC_API_KEY=ps_live_<PREENCHER>

# ── IA generativa (Groq) ──
# Chave em https://console.groq.com — somente servidor (nunca no frontend)
GROQ_API_KEY=<PREENCHER>

# ── Imagens em layouts gerados por IA (opcional) ──
# https://unsplash.com/developers — busca contextual; sem chave usa fallbacks curados
# UNSPLASH_ACCESS_KEY=<PREENCHER>

# ── Geração de imagens (Pollinations.ai — gratuito, sem chave obrigatória) ──
# https://image.pollinations.ai — model=flux, URLs diretas no builder
# POLLINATIONS_API_KEY=<opcional — enter.pollinations.ai para nologo garantido>
# POLLINATIONS_IMAGE_WIDTH=1024
# POLLINATIONS_IMAGE_HEIGHT=768
# IA_LAYOUT_IMAGE_MODE=stock — layouts genéricos; generate-layout de modelos força Pollinations
# Slots: hero_banner 1920x600, card 1200x800, inline 1024x768, avatar 512x512, gallery 800x800, carousel 1280x400
