NODE_ENV=development
PORT=3003
APP_URL=http://localhost:3003

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

JWT_SECRET=change-me-local
SESSION_COOKIE_NAME=propez_session

# URLs dos outros apps (local)
PROSYNC_API_URL=http://localhost:3001
PROSYNC_API_KEY=
PROSYNC_WEBHOOK_SECRET=

RUBRICA_API_URL=http://localhost:3002
RUBRICA_API_KEY=
RUBRICA_WEBHOOK_SECRET=

# Suíte — MESMO secret nos 4 projetos
TAGGO_SUITE_SECRET=COLE_openssl_rand_hex_64
CREDENTIALS_KEY=

# SSO — client propez do TAGGO_CLIENTS_JSON do site
TAGGO_SSO_ISSUER=http://localhost:3000
TAGGO_SSO_CLIENT_ID=propez
TAGGO_SSO_CLIENT_SECRET=SECRET_PROPEZ
TAGGO_SSO_REDIRECT_URI=http://localhost:3003/api/sso/callback

PROP_EZ_CHECK_URL=http://127.0.0.1:3003

SEED_EMAIL=dev@propez.local
