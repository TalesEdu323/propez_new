# =============================================================================
# PROPEZ — PRODUÇÃO
# Cole no painel de env do hosting (Vercel, Cloud Run, etc.)
# =============================================================================

NODE_ENV=production
PORT=3000
APP_URL=https://propez.taggo.com.br

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

JWT_SECRET=gerar-secret-forte-producao
SESSION_COOKIE_NAME=propez_session

# Integrações — URLs de produção (keys globais opcionais se suíte ativa)
PROSYNC_API_URL=https://prosync.tech
PROSYNC_API_KEY=
PROSYNC_WEBHOOK_SECRET=

RUBRICA_API_URL=https://app.rubrica.com.br
RUBRICA_API_KEY=
RUBRICA_WEBHOOK_SECRET=

# Suíte Taggo — MESMO TAGGO_SUITE_SECRET nos 4 apps
TAGGO_SUITE_SECRET=COLE_openssl_rand_hex_64
CREDENTIALS_KEY=COLE_chave_dedicada_ou_deixe_vazio_para_derivar

# SSO
TAGGO_SSO_ISSUER=https://accounts.taggo.com.br
TAGGO_SSO_CLIENT_ID=propez
TAGGO_SSO_CLIENT_SECRET=SECRET_PROPEZ
TAGGO_SSO_REDIRECT_URI=https://propez.taggo.com.br/api/sso/callback
