# =============================================================================
# PROSYNC — copie para Prosync/.env.local
# Porta dev: 3001  →  npx next dev -p 3001
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3001
AUTH_SECRET=COLE_openssl_rand_base64_32

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# Suíte — MESMO secret nos 4 projetos
TAGGO_SUITE_SECRET=COLE_openssl_rand_hex_64
SUITE_ADVANCED_MODE=false

# SSO — client prosync do TAGGO_CLIENTS_JSON do site
TAGGO_SSO_ISSUER=http://localhost:3000
TAGGO_SSO_CLIENT_ID=prosync
TAGGO_SSO_CLIENT_SECRET=SECRET_PROSYNC
TAGGO_SSO_REDIRECT_URI=http://localhost:3001/api/sso/callback
