# =============================================================================
# RUBRICA — copie trechos para Rubrica-Assinaturas/.env
# Porta dev: 3002  →  npx next dev -p 3002
# =============================================================================

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=your-jwt-secret-local
NEXT_PUBLIC_APP_URL=http://localhost:3002
NODE_ENV=development

# Suíte — MESMO secret nos 4 projetos
TAGGO_SUITE_SECRET=COLE_openssl_rand_hex_64
NEXT_PUBLIC_SUITE_ADVANCED_MODE=false

# SSO — client rubrica do TAGGO_CLIENTS_JSON do site
TAGGO_SSO_ISSUER=http://localhost:3000
TAGGO_SSO_CLIENT_ID=rubrica
TAGGO_SSO_CLIENT_SECRET=SECRET_RUBRICA
TAGGO_SSO_REDIRECT_URI=http://localhost:3002/api/sso/callback
