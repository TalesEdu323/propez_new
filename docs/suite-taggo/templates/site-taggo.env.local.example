# =============================================================================
# SITE TAGGO (IdP OIDC) — copie para site-novo-tgs/.env.local
# Porta dev: 3000
# =============================================================================

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

NEXTAUTH_SECRET=COLE_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
TAGGO_ISSUER=http://localhost:3000

# PEMs: openssl genpkey ... / openssl rsa -pubout ...
# Cole o conteúdo do arquivo ou use \n entre linhas
TAGGO_JWT_PRIVATE_KEY_PEM=
TAGGO_JWT_PUBLIC_KEY_PEM=
TAGGO_JWT_KID=taggo-1

TAGGO_ACCOUNTS_COOKIE_NAME=taggo_idp_session
TAGGO_ACCOUNTS_COOKIE_SECRET=COLE_openssl_rand_base64_32

# MESMO valor em Propez, ProSync e Rubrica
TAGGO_SUITE_SECRET=COLE_openssl_rand_hex_64

# Substitua SECRET_PROPEZ, SECRET_PROSYNC, SECRET_RUBRICA pelos hex gerados
TAGGO_CLIENTS_JSON=[{"clientId":"propez","clientSecret":"SECRET_PROPEZ","redirectUris":["http://localhost:3003/api/sso/callback"]},{"clientId":"prosync","clientSecret":"SECRET_PROSYNC","redirectUris":["http://localhost:3001/api/sso/callback"]},{"clientId":"rubrica","clientSecret":"SECRET_RUBRICA","redirectUris":["http://localhost:3002/api/sso/callback"]}]

ADMIN_EMAIL=teste@taggo.com.br
ADMIN_PASSWORD=Teste123!
IDENTITY_SEED_EMAIL=teste@taggo.com.br
IDENTITY_SEED_PASSWORD=Teste123!
IDENTITY_SEED_NAME=Teste Taggo
